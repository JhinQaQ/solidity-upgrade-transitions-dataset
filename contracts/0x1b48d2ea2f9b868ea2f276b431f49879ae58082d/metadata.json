    "devdoc": {
      "details": "Single plus for Vesper WBTC.",
      "kind": "dev",
      "methods": {
        "addTransaction(address,bytes)": {
          "details": "Add a new rebase hook.",
          "params": {
            "_data": "Transaction payload for the rebase hook.",
            "_destination": "Destination contract for the reabase hook."
          }
        },
        "allowance(address,address)": {
          "details": "See {IERC20-allowance}."
        },
        "approve(address,uint256)": {
          "details": "See {IERC20-approve}. Requirements: - `spender` cannot be the zero address."
        },
        "balanceOf(address)": {
          "details": "Returns the balance of plus token for the account. See {IERC20Updateable-balanceOf}."
        },
        "decimals()": {
          "details": "Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5,05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overloaded; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."
        },
        "decreaseAllowance(address,uint256)": {
          "details": "Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."
        },
        "divest()": {
          "details": "Retrive the underlying assets from the investment."
        },
        "donate(uint256)": {
          "details": "Allows anyone to donate their plus asset to all other holders.",
          "params": {
            "_amount": "Amount of plus token to donate."
          }
        },
        "getMintAmount(uint256)": {
          "details": "Returns the amount of single plus tokens minted with the underlying token provided._amounts Amount of underlying token used to mint the single plus token."
        },
        "getRedeemAmount(uint256)": {
          "details": "Returns the amount of tokens received in redeeming the single plus token.",
          "params": {
            "_amount": "Amounf of single plus to redeem."
          },
          "returns": {
            "_0": "Amount of underlying token received as well as fee collected."
          }
        },
        "harvest()": {
          "details": "Harvest additional yield from the investment. Only governance or strategist can call this function."
        },
        "harvestable()": {
          "details": "Returns the amount of reward that could be harvested now. harvestable > 0 means it's time to call harvest."
        },
        "increaseAllowance(address,uint256)": {
          "details": "Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address."
        },
        "initialize()": {
          "details": "Initializes vWBTC+."
        },
        "initialize(address,string,string)": {
          "details": "Initializes the single plus contract.",
          "params": {
            "_nameOverride": "If empty, the single plus name will be `token_name Plus`",
            "_symbolOverride": "If empty. the single plus name will be `token_symbol+`",
            "_token": "Underlying token of the single plus."
          }
        },
        "invest()": {
          "details": "Invest the underlying assets for additional yield."
        },
        "investable()": {
          "details": "Returns the amount that can be invested now. The invested token does not have to be the underlying token. investable > 0 means it's time to call invest."
        },
        "liquidityRatio()": {
          "details": "Returns the current liquidity ratio of the plus token in WAD."
        },
        "mint(uint256)": {
          "details": "Mints the single plus token with the underlying token._amount Amount of the underlying token used to mint single plus token."
        },
        "name()": {
          "details": "Returns the name of the token."
        },
        "permit(address,address,uint256,uint256,uint8,bytes32,bytes32)": {
          "details": "Gassless approve."
        },
        "rebase()": {
          "details": "Accrues interest to increase index."
        },
        "redeem(uint256)": {
          "details": "Redeems the single plus token.",
          "params": {
            "_amount": "Amount of single plus token to redeem. -1 means redeeming all shares."
          }
        },
        "removeTransaction(uint256)": {
          "details": "Remove a rebase hook.",
          "params": {
            "_index": "Index of the transaction to remove."
          }
        },
        "salvage()": {
          "details": "Used to salvage any ETH deposited to BTC+ contract by mistake. Only strategist can salvage ETH. The salvaged ETH is transferred to treasury for futher operation."
        },
        "salvageToken(address)": {
          "details": "Used to salvage any token deposited to plus contract by mistake. Only strategist can salvage token. The salvaged token is transferred to treasury for futhuer operation.",
          "params": {
            "_token": "Address of the token to salvage."
          }
        },
        "setGovernance(address)": {
          "details": "Updates governance. Only governance can update governance."
        },
        "setMintPaused(bool)": {
          "details": "Updates the mint paused state of the underlying token.",
          "params": {
            "_paused": "Whether minting with that token is paused."
          }
        },
        "setPerformanceFee(uint256)": {
          "details": "Updates the performance fee. Only governance can update the performance fee."
        },
        "setRedeemFee(uint256)": {
          "details": "Updates the redeem fee. Only governance can update redeem fee."
        },
        "setStrategist(address,bool)": {
          "details": "Updates strategist. Both governance and strategists can update strategist."
        },
        "setTreasury(address)": {
          "details": "Updates the treasury. Only governance can update treasury."
        },
        "symbol()": {
          "details": "Returns the symbol of the token, usually a shorter version of the name."
        },
        "totalSupply()": {
          "details": "Returns the total supply of plus token. See {IERC20Updateable-totalSupply}."
        },
        "totalUnderlying()": {
          "details": "Returns the total value of the plus token in terms of the peg value. For single plus, it's equal to its total supply. For composite plus, it's equal to the total amount of single plus tokens in its basket."
        },
        "transactionSize()": {
          "details": "Returns the number of rebase hook transactions."
        },
        "transfer(address,uint256)": {
          "details": "See {IERC20-transfer}. Requirements: - `recipient` cannot be the zero address. - the caller must have a balance of at least `amount`."
        },
        "transferFrom(address,address,uint256)": {
          "details": "See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. Requirements: - `sender` and `recipient` cannot be the zero address. - `sender` must have a balance of at least `amount`. - the caller must have allowance for ``sender``'s tokens of at least `amount`."
        },
        "updateTransaction(uint256,bool)": {
          "details": "Updates an existing rebase hook transaction.",
          "params": {
            "_enabled": "True for enabled, false for disabled.",
            "_index": "Index of transaction. Transaction ordering may have changed since adding."
          }
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {},
      "version": 1
    }
