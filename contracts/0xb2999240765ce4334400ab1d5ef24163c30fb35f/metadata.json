      "details": "The Compliance Registry stores user related attributes for multiple compliance authorities (named trusted intermediaries) * Error messages UR01: UserId is invalid UR02: Address is already attached UR03: Users length does not match with addresses length UR04: Address is not attached UR05: Attribute keys length does not match with attribute values length UR06: Transfer and transfer decisions must have the same length UR07: Only originator can cancel transfer UR08: Unsuccessful transfer UR09: Only on hold transfers can be canceled",
      "methods": {
        "addOnHoldTransfer(address,address,address,address,uint256)": {
          "details": "Adds a transfer to the on hold queue that will be processed by the trusted intermediaryIntended to ba called by transfer computing rules that has been granted the operator rightEmits a TransferOnHold event that can be listened by wallets for improved UX experience",
          "params": {
            "amount": "the amount of transfered tokens",
            "from": "the sender of the transfered tokens",
            "to": "the receiver of the transfered tokens",
            "token": "the transfered token address",
            "trustedIntermediary": "the trusted intermediary for which the transfer is placed on hold"
          }
        },
        "addOperator(address)": {
          "details": "Grants the operator right to _operator",
          "params": {
            "_operator": "the address to grant"
          }
        },
        "attachAddress(uint256,address)": {
          "details": "Attach an address to an existing userIntended to be called from a trusted intermediary keyThrows UR01 if user does not existThrows UR02 if address is already attachedEmits AddressAttached event",
          "params": {
            "_address": "the address to attach",
            "_userId": "the user id to which the address will be attached"
          }
        },
        "attachAddresses(uint256[],address[])": {
          "details": "Attach addresses to existing usersIntended to be called from a trusted intermediary keyThrows UR03 if _addresses length does not match _userIds lengthThrows UR02 if an address is already attachedThrows UR01 if user does not existEmits multiple AddressAttached events",
          "params": {
            "_addresses": "array of addresses to attach",
            "_userIds": "array of user ids to which an address will be attached"
          }
        },
        "attribute(address,uint256,uint256)": {
          "details": "get one user attribute",
          "params": {
            "_key": "the key of the attribute to return",
            "_trustedIntermediary": "the reference trusted intermediary of the user",
            "_userId": "the userId for which the attribute has to be returned"
          },
          "returns": {
            "_0": "the attribute value for the pair (_userId, _key), defaults to 0 if _key or _userId not found"
          }
        },
        "attributes(address,uint256,uint256[])": {
          "details": "access to multiple user attributes at once",
          "params": {
            "_keys": "array of keys of attributes to return",
            "_trustedIntermediary": "the reference trusted intermediary of the user",
            "_userId": "the userId for which attributes have to be returned"
          },
          "returns": {
            "_0": "the attribute values for each pair (_userId, _key), defaults to 0 if _key or _userId not found*"
          }
        },
        "cancelOnHoldTransfers(address,uint256[],bool)": {
          "details": "Called by user to cancel transfers for a specific trusted intermediary and get his tokens backThrows UR07 if any of the transfer does not have user address as the senderEmits a TransferCancelled event that can be listened by wallets for improved UX experience",
          "params": {
            "skipMinBoundaryUpdate": "whether to skip the minBoundary update or not. Updating minBoundary can result in out of gas exception. Skipping the update will process the transfers and the user will be able to update minBoundary by calling the updateOnHoldMinBoundary multiple times",
            "transfers": "array of transfer ids on hold with the trusted intermediary",
            "trustedIntermediary": "the trusted intermediary address for which the transfers are on hold"
          }
        },
        "detachAddress(address)": {
          "details": "Detach an address from a userIntended to be called from a trusted intermediary keyThrows UR04 if the address is not attachedEmits AddressDetached event",
          "params": {
            "_address": "address to detach"
          }
        },
        "detachAddresses(address[])": {
          "details": "Detach addresses from their respective userIntended to be called from a trusted intermediary keyThrows UR04 if an address is not attachedEmits multiple AddressDetached events",
          "params": {
            "_addresses": "array of addresses to detach"
          }
        },
        "getOnHoldTransfers(address)": {
          "details": "Fetch on hold transfers to be processed by a specific trusted intermediary",
          "params": {
            "trustedIntermediary": "the trusted intermediary for which on hold transfers will be fetched"
          },
          "returns": {
            "amount": "the array of amounts for on hold transfers",
            "from": "the array of sender addresses for on hold transfers",
            "id": "the array of ids for on hold transfers",
            "length": "the number of on hold transfers",
            "to": "the array of receiver addresses for on hold transfers",
            "token": "the array of token addresses for on hold transfers"
          }
        },
        "initialize(address)": {
          "details": "Initializer (replaces constructor when contract is upgradable)",
          "params": {
            "owner": "the final owner of the contract"
          }
        },
        "isAddressValid(address[],address)": {
          "details": "Get the validaty of an address for trusted intermediaries",
          "params": {
            "_address": "address to look for",
            "_trustedIntermediaries": "array of trusted intermediaries to look the address for"
          },
          "returns": {
            "_0": "true if a user corresponding to the address was found for a trusted intermediary and is not expired, false otherwise"
          }
        },
        "isOperator(address)": {
          "details": "Checks if the address in param _operator is granted the operator right",
          "params": {
            "_operator": "the address to check for operator right"
          },
          "returns": {
            "_0": "true if the address is granted the operator right, false otherwise"
          }
        },
        "isValid(address,uint256)": {
          "details": "checks if the user id passed in parameter is not expired",
          "params": {
            "_trustedIntermediary": "the reference trusted intermediary of the user",
            "_userId": "the userId to be checked"
          },
          "returns": {
            "_0": "true if a user was found for the trusted intermediary and is not expired, false otherwise"
          }
        },
        "monthlyInTransfers(address,address[],address)": {
          "details": "Returns the CHF amount transfered (IN) by an address for a 31 days period for a specific realm",
          "params": {
            "_address": "address to lookup",
            "_realm": "the realm for which we want the amount to be returned",
            "_trustedIntermediaries": "array of trustedIntermediaries in which we lookup the address"
          },
          "returns": {
            "_0": "the CHF amount transfered (IN) by an address for the period for a specific realm "
          }
        },
        "monthlyOutTransfers(address,address[],address)": {
          "details": "Returns the CHF amount transfered (OUT) by an address for a 31 days period for a specific realm",
          "params": {
            "_address": "address to lookup",
            "_realm": "the realm for which we want the amount to be returned",
            "_trustedIntermediaries": "array of trustedIntermediaries in which we lookup the address"
          },
          "returns": {
            "_0": "the CHF amount transfered (OUT) by an address for the period for a specific realm "
          }
        },
        "monthlyTransfers(address,address[],address)": {
          "details": "Returns the CHF amount transfered (IN and OUT) by an address for a 31 days period for a specific realm",
          "params": {
            "_address": "address to lookup",
            "_realm": "the realm for which we want the amount to be returned",
            "_trustedIntermediaries": "array of trustedIntermediaries in which we lookup the address"
          },
          "returns": {
            "_0": "the CHF amount transfered (IN and OUT) by an address for the period for a specific realm "
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "processOnHoldTransfers(uint256[],uint8[],bool)": {
          "details": "Processes on hold transfersIntended to be called from a trusted intermediary keyTransfer decision: 1 = Approve, 2 = RejectEmits either a TransferApproved or a TransferRejected event that can be listened by wallets for improved UX experienceWhen transfer is approved, tokens are transfered to the receiver of the tokensWhen transfer is rejected, tokens are transfered back to the sender of the tokensIf transfer is not on-hold, it will be ignored without notification",
          "params": {
            "skipMinBoundaryUpdate": "whether to skip the minBoundary update or not. Updating minBoundary can result in out of gas exception. Skipping the update will process the transfers and the user will be able to update minBoundary by calling the updateOnHoldMinBoundary multiple times",
            "transferDecisions": "array of transfer decisions applied to transfers",
            "transfers": "array of transfer ids to process"
          }
        },
        "registerUser(address,uint256[],uint256[])": {
          "details": "Registers a new user corresponding to an address and sets its initial attributesIntended to be called from a trusted intermediary keyThrows UR05 if _attributeKeys length is not the same as _attributeValues lengthThrows UR02 if address is already registered to a userEmits AddressAttached event",
          "params": {
            "_address": "the address to register",
            "_attributeKeys": "array of keys of attributes to set",
            "_attributeValues": "array of values of attributes to set"
          }
        },
        "registerUsers(address[],uint256[],uint256[])": {
          "details": "Registers multiple users corresponding to addresses and sets their initial attributesIntended to be called from a trusted intermediary keyIgnores already registered addressesThrows UR05 if _attributeKeys length is not the same as _attributeValues lengthEmits multiple AddressAttached events",
          "params": {
            "_addresses": "the array of addresses to register",
            "_attributeKeys": "array of keys of attributes to set",
            "_attributeValues": "array of values of attributes to set"
          }
        },
        "removeOperator(address)": {
          "details": "Removes the operator right from the _operator address",
          "params": {
            "_operator": "the address of the operator to remove"
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner.     * NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "transferOwnership(address)": {
          "details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
        },
        "updateOnHoldMinBoundary(uint256)": {
          "details": "Updates the minBoundary index but limiting iterations to avoid out of gas exceptionsIntended to be called from a trusted intermediary key",
          "params": {
            "maxIterations": "number of iterations allowed for the loop"
          }
        },
        "updateTransfers(address,address,address,uint256)": {
          "details": "Updates the transfer registryIntended to ba called by transfer computing rules that has been granted the operator right",
          "params": {
            "_from": "the sender of the tokens",
            "_realm": "the realm (group) of the exchanged token",
            "_to": "the receiver of the tokens",
            "_value": "transfered tokens value converted in CHF"
          }
        },
        "updateUserAttributes(uint256,uint256[],uint256[])": {
          "details": "Updates attributes for a userIntended to be called from a trusted intermediary keyThrows UR05 if _attributeKeys length is not the same as _attributeValues lengthThrows UR01 user is not found",
          "params": {
            "_attributeKeys": "array of keys of attributes to set",
            "_attributeValues": "array of values of attributes to set",
            "_userId": "the user id for which the attributes are updated"
          }
        },
        "updateUsersAttributes(uint256[],uint256[],uint256[])": {
          "details": "Updates attributes for many usersIntended to be called from a trusted intermediary keyThrows UR05 if _attributeKeys length is not the same as _attributeValues lengthIgnores not found users",
          "params": {
            "_attributeKeys": "array of keys of attributes to set",
            "_attributeValues": "array of values of attributes to set",
            "_userIds": "the user ids for which the attributes are updated"
          }
        },
        "userId(address[],address)": {
          "details": "fetch the userId associated to the provided address registered by trusted intermediariesThe algorithm loops through each trusted intermediary and returns the first userId found even if the user exists for next trusted intermediaries",
          "params": {
            "_address": "address to look for",
            "_trustedIntermediaries": "array of trusted intermediaries to look the address for"
          },
          "returns": {
            "_0": "userId the user id found, 0 if not found",
            "_1": "the address of the first trusted intermediary for which the user was found, 0x0 if no user was found"
          }
        },
        "validUntil(address,uint256)": {
          "details": "returns the date at which user validity ends (UNIX timestamp)",
          "params": {
            "_trustedIntermediary": "the reference trusted intermediary of the user",
            "_userId": "the userId for which the validity date has to be returned"
          },
          "returns": {
            "_0": "the date at which user validity ends (UNIX timestamp)"
          }
        },
        "yearlyInTransfers(address,address[],address)": {
          "details": "Returns the CHF amount transfered (IN) by an address for a 12 months period for a specific realm",
          "params": {
            "_address": "address to lookup",
            "_realm": "the realm for which we want the amount to be returned",
            "_trustedIntermediaries": "array of trustedIntermediaries in which we lookup the address"
          },
          "returns": {
            "_0": "the CHF amount transfered (IN) by an address for the period for a specific realm "
          }
        },
        "yearlyOutTransfers(address,address[],address)": {
          "details": "Returns the CHF amount transfered (OUT) by an address for a 12 months period for a specific realm",
          "params": {
            "_address": "address to lookup",
            "_realm": "the realm for which we want the amount to be returned",
            "_trustedIntermediaries": "array of trustedIntermediaries in which we lookup the address"
          },
          "returns": {
            "_0": "the CHF amount transfered (OUT) by an address for the period for a specific realm "
          }
        },
        "yearlyTransfers(address,address[],address)": {
          "details": "Returns the CHF amount transfered (IN and OUT) by an address for a 12 months period for a specific realm",
          "params": {
            "_address": "address to lookup",
            "_realm": "the realm for which we want the amount to be returned",
            "_trustedIntermediaries": "array of trustedIntermediaries in which we lookup the address"
          },
          "returns": {
            "_0": "the CHF amount transfered (IN and OUT) by an address for the period for a specific realm "
          }
        }
      },
      "title": "ComplianceRegistry"
    },
    "userdoc": {
      "methods": {}
    }
