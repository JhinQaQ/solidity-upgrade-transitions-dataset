    "devdoc": {
      "author": "Ribbon Team",
      "kind": "dev",
      "methods": {
        "constructor": {
          "custom:oz-upgrades-unsafe-allow": "constructor"
        },
        "depositCollateral(uint256,uint256,(uint256,uint256,address,uint8,bytes32,bytes32))": {
          "details": "can only be called by the market maker who is the order seller",
          "params": {
            "_amount": "amount to deposit (with its respective token decimals)",
            "_mmSignature": "market maker permit signature",
            "_orderID": "id of the order"
          }
        },
        "executeOrder(uint256,(uint256,uint256,address,uint8,bytes32,bytes32),(uint256,uint256,address,uint8,bytes32,bytes32),uint256,address,uint256)": {
          "details": "can only be called by whitelisted market makers      requires that product and collateral have already been whitelisted beforehand      ensure that initial margin has been set up beforehand      ensure collateral naked cap from Controller.sol is high enough for the additional collateral      ensure setUpperBoundValues and setSpotShock from MarginCalculator.sol have been set up",
          "params": {
            "_collateralAmount": "collateral amount (with its respective token decimals)",
            "_collateralAsset": "collateral asset address",
            "_mmSignature": "market maker permit signature",
            "_orderID": "id of the order",
            "_premium": "order premium amount (USDC value with USDC decimals)",
            "_userSignature": "user permit signature"
          }
        },
        "initialize(address,address,uint256)": {
          "params": {
            "_addressBook": "AddressBook address",
            "_beneficiary": "beneficiary address",
            "_fillDeadline": "fill deadline duration in seconds"
          }
        },
        "owner()": {
          "details": "Returns the address of the current owner."
        },
        "placeOrder(address,bool,uint256,uint256,uint256,uint256)": {
          "params": {
            "_expiry": "option expiry timestamp",
            "_isPut": "option type the vault is selling",
            "_notional": "order notional (USD value with 6 decimals)",
            "_premium": "order premium amount (USDC value with USDC decimals)",
            "_strikePrice": "option strike price (with its respective token decimals)",
            "_underlying": "underlying asset address"
          }
        },
        "renounceOwnership()": {
          "details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."
        },
        "setBeneficiary(address)": {
          "details": "can only be called by owner",
          "params": {
            "_beneficiary": "beneficiary address"
          }
        },
        "setFee(address,uint256)": {
          "details": "can only be called by owner",
          "params": {
            "_fee": "fee amount in bps with 2 decimals (400 = 4bps = 0.04%)",
            "_underlying": "underlying asset address"
          }
        },
        "setFillDeadline(uint256)": {
          "details": "can only be called by owner",
          "params": {
            "_fillDeadline": "fill deadline duration in seconds"
          }
        },
        "setMinMaxNotional(address,uint256,uint256)": {
          "details": "can only be called by owner",
          "params": {
            "_max": "maximum USD notional value allowed (with 6 decimals)",
            "_min": "minimum USD notional value allowed (with 6 decimals)",
            "_underlying": "underlying asset address"
          }
        },
        "setWhitelistMarketMaker(address,bool)": {
          "details": "can only be called by owner",
          "params": {
            "_isWhitelisted": "bool with whitelist status",
            "_marketMakerAddress": "address of the market maker"
          }
        },
        "settleVault(uint256)": {
          "details": "can only be called by the market maker who is the order seller",
          "params": {
