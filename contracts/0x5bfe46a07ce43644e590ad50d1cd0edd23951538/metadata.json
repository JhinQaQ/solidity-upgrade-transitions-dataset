          "details": "Batch burn from an operator or admin address.\r",
          "params": {
            "_recipients": "Array of recipient addresses.\r",
            "_values": "Array of amount to burn.\r"
          }
        },
        "batchConfiscate(address[],address[],uint256[])": {
          "details": "Batch confiscate to a macimum of 255 addresses. \r",
          "params": {
            "_confiscatees": "array addresses who's funds are being confiscated\r",
            "_receivers": "array addresses who's receiving the funds\r",
            "_values": "array of values of funds being confiscated\r"
          }
        },
        "batchMint(address[],uint256[])": {
          "details": "Batch mint to a maximum of 255 addresses, for a custom amount for each address.\r",
          "params": {
            "_recipients": "Array of recipient addresses.\r",
            "_values": "Array of amount to mint.\r"
          }
        },
        "batchToggleFreeze(address[],bool)": {
          "details": "Batch freeze/unfreeze multiple addresses, with _toggled being true/false.\r",
